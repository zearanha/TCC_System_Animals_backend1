generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum OcorrenciaStatus {
  ABERTA
  RESOLVIDA
  CANCELADA
}

enum NotificacaoCanal {
  SMS
  EMAIL
  WHATSAPP
}

enum NotificacaoStatus {
  PENDENTE
  ENVIADA
  FALHA
}

enum UsuarioPerfil {
  ADMIN
  AGENTE
  PROPRIETARIO
}

model Proprietario {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  cpf           String        @unique
  telefone      String?
  email         String?
  endereco      String?
  fotoPerfilUrl String?       @map("foto_perfil_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  animais       Animal[]
  notificacoes  Notificacao[]
  usuario       Usuario?

  @@map("proprietarios")
}

model Animal {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  nome           String
  especie        String
  raca           String?
  porte          String?
  sexo           String?
  cor            String?
  dataNascimento DateTime?      @map("data_nascimento")
  proprietarioId String         @map("proprietario_id") @db.ObjectId
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  proprietario   Proprietario   @relation(fields: [proprietarioId], references: [id])
  identificacao  Identificacao?
  ocorrencias    Ocorrencia[]

  @@index([proprietarioId])
  @@map("animais")
}

model Identificacao {
  id        String                 @id @default(auto()) @map("_id") @db.ObjectId
  codigo    String                 @unique
  animalId  String                 @unique @map("animal_id") @db.ObjectId
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  animal    Animal                 @relation(fields: [animalId], references: [id])
  imagens   IdentificacaoImagem[]

  @@map("identificacoes")
}

model IdentificacaoImagem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  identificacaoId String        @map("identificacao_id") @db.ObjectId
  imagemUrl       String        @map("imagem_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  identificacao   Identificacao @relation(fields: [identificacaoId], references: [id])

  @@index([identificacaoId])
  @@map("identificacao_imagens")
}

model Agente {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  nome       String
  matricula  String      @unique
  telefone   String?
  email      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  ocorrencias Ocorrencia[]
  usuario    Usuario?

  @@map("agentes")
}

model Usuario {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  nome           String
  email          String        @unique
  senhaHash      String        @map("senha_hash")
  perfil         UsuarioPerfil
  ativo          Boolean       @default(true)
  proprietarioId String?       @unique @map("proprietario_id") @db.ObjectId
  agenteId       String?       @unique @map("agente_id") @db.ObjectId
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  proprietario   Proprietario? @relation(fields: [proprietarioId], references: [id])
  agente         Agente?       @relation(fields: [agenteId], references: [id])
  sessoes        Sessao[]

  @@map("usuarios")
}

model Sessao {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  token      String   @unique
  usuarioId  String   @map("usuario_id") @db.ObjectId
  expiraEm   DateTime @map("expira_em")
  revogadaEm DateTime? @map("revogada_em")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("sessoes")
}

model Ocorrencia {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  animalId       String           @map("animal_id") @db.ObjectId
  agenteId       String           @map("agente_id") @db.ObjectId
  local          String
  descricao      String
  dataOcorrencia DateTime         @default(now()) @map("data_ocorrencia")
  status         OcorrenciaStatus @default(ABERTA)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  animal         Animal           @relation(fields: [animalId], references: [id])
  agente         Agente           @relation(fields: [agenteId], references: [id])
  notificacoes   Notificacao[]

  @@index([animalId])
  @@index([agenteId])
  @@map("ocorrencias")
}

model Notificacao {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  ocorrenciaId   String           @map("ocorrencia_id") @db.ObjectId
  proprietarioId String           @map("proprietario_id") @db.ObjectId
  mensagem       String
  canal          NotificacaoCanal @default(SMS)
  status         NotificacaoStatus @default(PENDENTE)
  dataEnvio      DateTime?        @map("data_envio")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  ocorrencia     Ocorrencia       @relation(fields: [ocorrenciaId], references: [id])
  proprietario   Proprietario     @relation(fields: [proprietarioId], references: [id])

  @@index([ocorrenciaId])
  @@index([proprietarioId])
  @@map("notificacoes")
}
